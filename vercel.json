      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr/ventes",
      "destination": "/fr/vente",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "nlgconsulting.co"
        }
      ],
      "destination": "https://www.nlgconsulting.co/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
