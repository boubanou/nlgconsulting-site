{
  "redirects": [
    {
      "source": "/en",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/fr/ventes",
      "destination": "/fr/vente",
      "permanent": true
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "nlgconsulting.co"
        }
      ],
      "destination": "https://www.nlgconsulting.co/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/fr",
      "destination": "/fr/index.html"
    },
    {
      "source": "/ai-consulting",
      "destination": "/ai-consulting/index.html"
    },
    {
      "source": "/fr/conseil-ia",
      "destination": "/fr/conseil-ia/index.html"
    },
    {
      "source": "/ai-automation",
      "destination": "/ai-automation/index.html"
    },
    {
      "source": "/fr/automation-ia",
      "destination": "/fr/automation-ia/index.html"
    },
    {
      "source": "/ai-agents-for-business",
      "destination": "/ai-agents-for-business/index.html"
    },
    {
      "source": "/fr/agents-ia-entreprise",
      "destination": "/fr/agents-ia-entreprise/index.html"
    },
    {
      "source": "/ai-sales-automation",
      "destination": "/ai-sales-automation/index.html"
    },
    {
      "source": "/fr/automation-commerciale-ia",
      "destination": "/fr/automation-commerciale-ia/index.html"
